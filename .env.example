# Soft Petals — environment variables
# Copy to .env.local for local dev; set the same in Vercel for production.

# Supabase project URL (Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — safe for the browser; data is protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: canonical site URL for share previews.
# On Vercel it falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=
